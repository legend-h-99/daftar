# Local development. Production uses the Supabase API configured in Cloudflare Pages.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Server-side Next.js rewrite target for /api-proxy/:path*.
# In Vercel, set this to your hosted API URL, e.g. https://daftar-api.example.com/api.
API_PROXY_TARGET=http://localhost:3001/api

# Use true only when the hosted API has DEMO_AUTH_ENABLED=true.
NEXT_PUBLIC_DEMO_LOGIN=false

# Google OAuth web client ID. Must match apps/api GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=269103980010-fbvbr60h67qh60j8cbib2a9agle2087n.apps.googleusercontent.com

# Production release: Google only. Keep the matching Edge EMAIL_LOGIN_ENABLED off.
NEXT_PUBLIC_EMAIL_LOGIN_ENABLED=false
NEXT_PUBLIC_PHONE_LOGIN_ENABLED=false

# Cloudflare Pages uses HttpOnly sessions through /api-proxy automatically.
# Set true only to test a local static release with the Pages Worker.
NEXT_PUBLIC_SESSION_PROXY_ENABLED=false
# Optional Pages Worker runtime binding for an isolated Supabase QA project:
# DAFTAR_API_URL=https://YOUR_QA_PROJECT.supabase.co/functions/v1/api

# Product analytics (PostHog). Leave empty to disable; nothing is sent without a key.
# Events carry an anonymous device id and counts only, never names, emails or amounts.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
