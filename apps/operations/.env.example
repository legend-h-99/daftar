# Dedicated operations database only. Never point this at Daftar production.
OPS_DATABASE_URL=postgresql://operations:operations@localhost:5544/operations
OPS_ORIGIN=http://localhost:3100
OPS_OWNER_EMAIL=hossam@example.com
# Generate with pnpm --filter @daftar/operations password (reads stdin).
OPS_PASSWORD_HASH=
OPS_SESSION_SECRET=
# Public website allowed to submit support tickets. Exact origin, no wildcard.
OPS_SUPPORT_ORIGIN=https://daftar1.com
OPS_IP_HASH_SECRET=
# Off until the owner saves a budget and approves activation in the UI.
OPENAI_API_KEY=
OPS_MODEL=
# Rates in SAR per million tokens, verified at configuration time.
OPS_INPUT_SAR_PER_MILLION=
OPS_OUTPUT_SAR_PER_MILLION=
RESEND_API_KEY=
OPS_SUPPORT_FROM=
# Conservative upper bound charged per sent email (SAR).
OPS_EMAIL_MAX_SAR=
# Exact HTTPS endpoint returning aggregate JSON; use a scoped read-only credential.
OPS_METRICS_URL=
OPS_METRICS_TOKEN=
# Engineering runner: optional, requires Docker and a clean trusted source checkout.
OPS_REPO_PATH=
OPS_SANDBOX_IMAGE=
OPS_ARTIFACTS_DIR=
