{
  "name": "@daftar/operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx --env-file-if-exists=.env.local src/worker.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "password": "tsx scripts/password.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx test/browser.mts",
    "db:local": "tsx scripts/local-db.ts",
    "bootstrap:local": "tsx --env-file-if-exists=.env.local scripts/bootstrap.ts"
  },
  "dependencies": {
    "next": "15.5.24",
    "pg": "^8.16.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.6",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "^5.7.2"
  }
}
