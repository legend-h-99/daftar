# Build from the repository root using a trusted, reviewed checkout.
# This image contains dependencies and a fixed test command, never runtime secrets.
FROM node:22-bookworm-slim
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --filter web --frozen-lockfile --ignore-scripts
COPY apps/operations/scripts/sandbox-test.sh /usr/local/bin/sandbox-test
RUN chmod 755 /usr/local/bin/sandbox-test
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/sandbox-test"]
