// This file mirrors the database. It is not the schema source of truth.
// The Supabase SQL migrations are (AgDR-0004). Change the schema with a new
// file in supabase/migrations/, then update this file to match.
// CI fails when the two differ: scripts/db/check-schema-drift.sh.
// Prisma cannot express RLS, check constraints, partial indexes or SQL
// functions, so those live only in the SQL migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Unit {
  KG
  GRAM
  LITER
  ML
  PIECE
}

enum RecipeItemType {
  RAW
  PACKAGING
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
}

enum ExpenseCategory {
  RENT
  SALARIES
  INGREDIENTS
  PACKAGING
  MARKETING
  DELIVERY
  UTILITIES
  OTHER
}

model Business {
  id         String   @id @default(uuid())
  name       String
  ownerPhone String?  @unique
  vatEnabled Boolean  @default(false)
  vatNumber  String?
  city       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  users             User[]
  materials         Material[]
  products          Product[]
  customers         Customer[]
  invoices          Invoice[]
  invoicePayments   InvoicePayment[]
  operationRequests OperationRequest[]
  fundingEntries    FundingEntry[]
  expenses          Expense[]
  suppliers         Supplier[]
  purchases         Purchase[]
  stockMovements    StockMovement[]
}

model User {
  id            String    @id @default(uuid())
  phone         String?   @unique
  // Unique when not null: partial index "User_email_key" in the SQL
  // migrations. Prisma cannot express a partial index, so look users up by
  // email with findFirst.
  email         String?
  emailVerified Boolean?  @default(false)
  tokenVersion  Int       @default(0)
  passwordHash  String?
  // Google account subject ("sub" claim).
  googleId      String?
  name          String?
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token, consumed, expiresAt])
  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token, consumed, expiresAt])
  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  // Failed verification attempts; the code is invalidated after 5.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Material {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id])
  name          String
  unit          Unit
  purchasePrice Float
  purchaseQty   Float
  unitPrice     Float
  // VAT % included in purchasePrice (informational: cost basis stays what
  // the owner actually paid; the extracted VAT portion is shown in the UI).
  vatRate       Float     @default(0)
  stockQty      Float     @default(0)
  reorderLevel  Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt @db.Timestamp(6)

  recipeItems    RecipeItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, stockQty])
}

enum PurchaseSource {
  MANUAL
  OCR
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
}

model Supplier {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  phone      String?
  createdAt  DateTime @default(now())

  purchases Purchase[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, name])
}

model Purchase {
  id              String         @id @default(uuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id])
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  number          Int
  date            DateTime       @default(now())
  total           Float
  notes           String?
  source          PurchaseSource @default(MANUAL)
  createdAt       DateTime       @default(now())
  voidedAt        DateTime?      @db.Timestamptz(6)
  inventoryBefore Json?
  inventoryAfter  Json?

  items PurchaseItem[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([businessId, date])
  @@index([businessId, number])
  @@index([businessId, supplierId])
  @@index([businessId, createdAt])
}

model PurchaseItem {
  id         String    @id @default(uuid())
  purchaseId String
  purchase   Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])
  name       String
  unit       Unit
  quantity   Float
  unitPrice  Float
  lineTotal  Float
}

// Append-only inventory ledger: every stock change (purchase in, sale out,
// manual adjustment) is one signed row, so the current balance is always
// explainable and auditable.
model StockMovement {
  id           String            @id @default(uuid())
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id])
  materialId   String
  material     Material          @relation(fields: [materialId], references: [id])
  type         StockMovementType
  qty          Float // signed: positive = in, negative = out
  balanceAfter Float
  costAmount   Float?
  // 'PURCHASE' or 'INVOICE'. A text column in the database.
  refType      String?
  refId        String?
  note         String?
  createdAt    DateTime          @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, materialId, createdAt])
  @@index([materialId])
}

model Product {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  name          String
  category      String?
  rawCost       Float    @default(0)
  packagingCost Float    @default(0)
  overheadCost  Float    @default(0)
  totalCost     Float    @default(0)
  profitMargin  Float    @default(30)
  sellingPrice  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipeItems  RecipeItem[]
  invoiceItems InvoiceItem[]

  @@index([businessId])
  @@index([businessId, createdAt])
}

model RecipeItem {
  id           String         @id @default(uuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId   String?
  material     Material?      @relation(fields: [materialId], references: [id])
  name         String
  unit         Unit
  unitPrice    Float
  quantityUsed Float
  lineCost     Float
  type         RecipeItemType @default(RAW)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime?      @updatedAt @db.Timestamp(6)

  @@index([materialId])
  @@index([productId, materialId])
}

model Customer {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  phone      String?
  createdAt  DateTime @default(now())

  invoices Invoice[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, name])
}

model Invoice {
  id              String        @id @default(uuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  number          Int
  status          InvoiceStatus @default(UNPAID)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  subtotal        Float
  vatAmount       Float         @default(0)
  total           Float
  paidAmount      Float         @default(0)
  notes           String?
  createdAt       DateTime      @default(now())
  idempotencyKey  String?
  idempotencyHash String?
  voidedAt        DateTime?     @db.Timestamptz(6)

  items    InvoiceItem[]
  payments InvoicePayment[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([businessId, issueDate])
  @@index([businessId, status, issueDate])
  @@index([businessId, status, dueDate])
  @@index([businessId, number])
  @@index([businessId, createdAt])
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  unitPrice Float
  quantity  Float
  lineTotal Float
  position  Int      @default(0)

  @@index([productId])
  @@index([invoiceId, position])
}

// Payment ledger: one row per payment recorded against an invoice. Written
// by the Supabase functions; RLS and check constraints are in the SQL.
model InvoicePayment {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onUpdate: NoAction)
  invoiceId  String
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onUpdate: NoAction)
  amount     Float
  occurredAt DateTime? @db.Timestamptz(6)
  recordedAt DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  source     String

  @@index([businessId, occurredAt], map: "InvoicePayment_business_date_idx")
}

// Idempotency records for mutating API requests.
model OperationRequest {
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind        String
  key         String
  fingerprint String
  response    Json

  @@id([businessId, kind, key])
}

model Expense {
  id         String          @id @default(uuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id])
  category   ExpenseCategory
  amount     Float
  date       DateTime
  note       String?
  createdAt  DateTime        @default(now())

  @@index([businessId])
  @@index([businessId, date])
  @@index([businessId, category])
}

model TokenBlacklist {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model FundingEntry {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  requestId String @db.Uuid
  kind String
  amount Decimal @db.Decimal(14, 2)
  date DateTime @db.Date
  note String?
  createdAt DateTime @default(now()) @db.Timestamptz
  @@unique([businessId, requestId])
  @@index([businessId, date], map: "FundingEntry_business_date_idx")
}

model AdminAuditLog {
  id           BigInt   @id @default(autoincrement())
  adminUserId  String
  action       String
  targetUserId String?
  result       String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

model ApiErrorEvent {
  id        BigInt   @id @default(autoincrement())
  method    String
  path      String
  status    Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

model AuthRateLimit {
  key         String   @id
  windowStart DateTime @db.Timestamptz(6)
  count       Int
}

model ExternalUsageBudget {
  key       String
  usageDate DateTime @db.Date
  used      Int      @default(0)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([key, usageDate])
}

model ProductAnalyticsEvent {
  id         String   @id @db.Uuid
  deviceId   String   @db.Uuid
  sessionId  String   @db.Uuid
  event      String
  path       String
  source     String
  properties Json     @default("{}")
  occurredAt DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@index([deviceId, createdAt], map: "product_analytics_device_time_idx")
  @@index([createdAt], map: "product_analytics_time_idx")
}
