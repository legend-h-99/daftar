# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daftar?schema=public"

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# Comma-separated list of allowed CORS origins (the web frontend URL)
CORS_ORIGIN="http://localhost:3000"

# Port the API server listens on
PORT=3001

# Optional hosted demo accounts. Keep false for real production auth.
DEMO_AUTH_ENABLED=false

# Google OAuth web client ID. Required for POST /api/auth/google.
GOOGLE_CLIENT_ID=""

# Public frontend URL used in email verification links.
APP_URL="http://localhost:3000"

# Optional email provider for production verification emails.
RESEND_API_KEY=""
EMAIL_FROM="Daftar <onboarding@resend.dev>"
