{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 3000
    },
    {
      "name": "web-phone",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_PHONE_LOGIN_ENABLED=true", "pnpm", "--filter", "web", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "api", "start:dev"],
      "port": 3001
    }
  ]
}
